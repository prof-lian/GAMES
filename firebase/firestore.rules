rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Administrador = conta logada cujo UID tem um documento na coleção "admins"
    function isAdmin() {
      return request.auth != null
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    // Ranking dos jogos (EduPlay · Professor Lian Ribeiro)
    match /ranking/{id} {
      // qualquer pessoa pode ver o ranking
      allow read: if true;

      // qualquer pessoa pode gravar uma pontuação nova, só neste formato
      allow create: if request.resource.data.keys().hasOnly(['jogo','nome','escola','turma','pontos','tempo','niveis','data'])
        && request.resource.data.jogo is string   && request.resource.data.jogo.size() <= 40
        && request.resource.data.nome is string   && request.resource.data.nome.size() >= 2 && request.resource.data.nome.size() <= 40
        && request.resource.data.escola is string && request.resource.data.escola.size() <= 100
        && request.resource.data.turma is string  && request.resource.data.turma.size() <= 30
        && request.resource.data.pontos is int    && request.resource.data.pontos >= 0 && request.resource.data.pontos <= 5000
        && request.resource.data.tempo is int     && request.resource.data.tempo >= 0 && request.resource.data.tempo <= 36000
        && (!('niveis' in request.resource.data) || request.resource.data.niveis is map)
        && request.resource.data.data == request.time;

      // só o professor corrige nome/escola/turma (pontos e tempo nunca mudam) ou apaga
      allow update: if isAdmin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['nome','escola','turma']);
      allow delete: if isAdmin();
    }

    // Cadastros feitos na página admin-jogos: todos leem, só o professor altera
    match /escolas/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /alunos/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /config/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Lista de administradores: criada só pelo console do Firebase
    match /admins/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if false;
    }
  }
}
